/build/
/out/
__pycache__/
*.py[cod]
.venv/

# Generated render outputs of local fixture runs. Certified JSON goldens and
# fixtures stay tracked; renders, previews, timings and binary frames under
# output dirs do not (tracked files are unaffected by these rules).
/output/
/out/
tools/**/out/
short_phrase/**/out/
catalog/**/out/
output/**/*.png
output/**/*.mp4
out/**/*.log

# Local CTest output belongs to working directories, not the source tree.
/Testing/
assets/screenrecording_word_lens/frame_*.png

# Local fixture runs (2026-11-05) write timings and previews under renders/,
# and an emitter invoked with a stray flag dropped a plan dump into a
# directory literally named "--help". Neither is source: certified goldens
# live in golden_plans/ and the catalog samples next to the catalogs.
/renders/
/--help/
