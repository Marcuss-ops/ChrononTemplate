// Canonical ordered camera preset roster.
// Each row owns the complete authored CameraMotionSpec payload after its key,
// stable catalog ID, and family. Durations are frames at 30 fps; distances are
// framing fractions; X/Y are frame fractions; angles are degrees; focus is pct.
//
// Three presets per family. Every single-shot preset travels its body and
// settles into a hold; the loop preset returns to its start pose; every
// transition is a two-shot cut.
CAMERA_MOTION_PRESET(TitleSlowPush, "camera_motion_title_slow_push", EditorialTitle, spec.durationFrames = 90; spec.distStart = 1.08f; spec.distEnd = 1.00f; spec.easing = "cinematic";)
CAMERA_MOTION_PRESET(TitleLateralDrift, "camera_motion_title_lateral_drift", EditorialTitle, spec.durationFrames = 96; spec.xStart = 0.05f; spec.xEnd = -0.05f; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(TitleRiseSettle, "camera_motion_title_rise_settle", EditorialTitle, spec.durationFrames = 72; spec.distStart = 1.03f; spec.distEnd = 1.00f; spec.yStart = 0.04f; spec.yEnd = 0.f; spec.easing = "gentle_out";)
CAMERA_MOTION_PRESET(PortraitArc, "camera_motion_portrait_arc", PhotoDocumentary, spec.durationFrames = 108; spec.distStart = 1.04f; spec.distEnd = 1.00f; spec.yawStart = -12.f; spec.yawEnd = 12.f; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(ArchiveReveal, "camera_motion_archive_reveal", PhotoDocumentary, spec.durationFrames = 84; spec.distStart = 1.10f; spec.distEnd = 1.00f; spec.xStart = 0.06f; spec.xEnd = 0.f; spec.easing = "gentle_out";)
CAMERA_MOTION_PRESET(RackFocusPortrait, "camera_motion_rack_focus_portrait", PhotoDocumentary, spec.durationFrames = 78; spec.distStart = 1.04f; spec.distEnd = 1.00f; spec.focusStart = 20.f; spec.focusEnd = 75.f; spec.needsDof = true; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(MapRegionPush, "camera_motion_map_region_push", MapGeo, spec.durationFrames = 96; spec.distStart = 1.15f; spec.distEnd = 0.92f; spec.easing = "cinematic";)
CAMERA_MOTION_PRESET(MapRouteTrack, "camera_motion_map_route_track", MapGeo, spec.durationFrames = 120; spec.xStart = -0.08f; spec.xEnd = 0.08f; spec.yStart = 0.03f; spec.yEnd = -0.03f; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(MapCountryTilt, "camera_motion_map_country_tilt", MapGeo, spec.durationFrames = 100; spec.distStart = 1.05f; spec.distEnd = 0.95f; spec.pitchStart = -10.f; spec.pitchEnd = 0.f; spec.easing = "gentle_out";)
CAMERA_MOTION_PRESET(UiPanelPush, "camera_motion_ui_panel_push", DashboardUI, spec.durationFrames = 64; spec.distStart = 1.08f; spec.distEnd = 1.00f; spec.easing = "gentle_out";)
CAMERA_MOTION_PRESET(UiCardParallax, "camera_motion_ui_card_parallax", DashboardUI, spec.durationFrames = 90; spec.xStart = -0.04f; spec.xEnd = 0.04f; spec.yawStart = -6.f; spec.yawEnd = 6.f; spec.needsMultiPlane = true; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(UiMicroFloat, "camera_motion_ui_micro_float", DashboardUI, spec.durationFrames = 150; spec.xMid = 0.012f; spec.yMid = -0.012f; spec.posMidAt = 0.5f; spec.easing = "smooth";)
CAMERA_MOTION_PRESET(WhipPanLeft, "camera_motion_whip_pan_left", Transition, spec.durationFrames = 14; spec.xEnd = -0.38f; spec.twoShot = true; spec.highEnergy = true; spec.snapIn = true; spec.easing = "whip_in";)
CAMERA_MOTION_PRESET(WhipPanRight, "camera_motion_whip_pan_right", Transition, spec.durationFrames = 14; spec.xEnd = 0.38f; spec.twoShot = true; spec.highEnergy = true; spec.snapIn = true; spec.easing = "whip_in";)
CAMERA_MOTION_PRESET(DollyHandoff, "camera_motion_dolly_handoff", Transition, spec.durationFrames = 22; spec.distStart = 1.00f; spec.distEnd = 0.70f; spec.twoShot = true; spec.highEnergy = true; spec.needsMultiPlane = true; spec.snapIn = true; spec.easing = "whip_in";)
