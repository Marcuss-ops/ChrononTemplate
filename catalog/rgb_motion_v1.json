{
  "schema": "chronontemplate.rgb-motion.v1",
  "version": 1,
  "family_id": "rgb_motion_v1",
  "canvas": {"width": 960, "height": 540, "fps": 30},
  "composition": "template_layer_expansion",
  "recipes": [
    {"id": "rgb_wave_in", "operator": "rgb_channel_transform", "warp": "wave_warp"},
    {"id": "rgb_slice_break", "operator": "slice_transform", "orientation": "horizontal"},
    {"id": "rgb_vertical_trail", "operator": "multi_tap_trail", "axis": "vertical"},
