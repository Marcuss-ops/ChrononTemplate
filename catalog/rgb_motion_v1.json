    {"id": "rgb_spin_blur", "minimum_frames": 6, "maximum_frames": 10, "recommended_frames": 8, "timing_class": "normal"},
    {"id": "prismatic_flash", "minimum_frames": 6, "maximum_frames": 10, "recommended_frames": 8, "timing_class": "normal"},
    {"id": "lightleak_rgb_combo", "minimum_frames": 8, "maximum_frames": 12, "recommended_frames": 10, "timing_class": "normal"},
    {"id": "film_burn_rgb", "minimum_frames": 8, "maximum_frames": 12, "recommended_frames": 10, "timing_class": "normal"}
