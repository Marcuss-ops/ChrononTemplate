    {"id": "rgb_temporal_split", "operator": "rgb_channel_transform", "driver": "analytic_transform_sample"},
    {"id": "rgb_prism_smear", "operator": "multi_tap_trail", "palette": "spectrum"},
    {"id": "rgb_ghost_echo", "operator": "multi_tap_trail", "palette": "rgb"},
