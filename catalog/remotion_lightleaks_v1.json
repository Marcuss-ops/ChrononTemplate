{
  "schema": "chronontemplate.remotion-lightleaks.v1",
  "version": 3,
  "family_id": "remotion_lightleaks_v1",
  "description": "High-quality 2.0s curated analog optical light leak transitions inspired by Remotion @remotion/effects and 35mm / anamorphic cinematic lens flares",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration_sec": 2.0,
    "duration_frames": 120
  },
  "blending_modes": [
    "screen",
    "add",
    "linear_dodge"
  ],
  "transitions": [
    {
      "id": "transition_01_warm_golden_sweep",
      "title": "Warm Golden Flare Sweep",
      "style": "Kodak Vision3 500T warm optical sweep",
      "duration_frames": 120,
      "duration_sec": 2.0,
      "fps": 60,
      "direction": "diagonal_top_left_to_bottom_right",
      "peak_frame": 60,
      "palette": "burnt_crimson_to_molten_gold",
      "filename": "transition_01_warm_golden_sweep.mp4"
    },
    {
      "id": "transition_02_film_burn_edge_flash",
      "title": "35mm Film Burn Edge Flash",
      "style": "Molten perforation leak with soot occlusion",
      "duration_frames": 120,
      "duration_sec": 2.0,
      "fps": 60,
      "direction": "edge_left_to_center",
      "peak_frame": 60,
      "palette": "carmine_scarlet_cadmium_amber",
      "filename": "transition_02_film_burn_edge_flash.mp4"
    },
    {
